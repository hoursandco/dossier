# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI extraction
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SHADOW_ENABLED=false
OPENROUTER_SHADOW_DAILY_LIMIT=0
OPENROUTER_SHADOW_SAMPLE_RATE=0

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@dossier.email

# Gmail (IMAP + App Password — no OAuth, no rotation)
# 1. Enable 2-Step Verification on the Gmail account
# 2. Visit https://myaccount.google.com/apppasswords → generate one
# 3. Paste the 16-char password below (spaces are stripped automatically)
GMAIL_SCRAP_EMAIL=ddingest@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
CRON_SECRET=your-cron-secret-token
# Number of emails processed concurrently during ingest (default 5).
# Higher = faster ingest but more pressure on the extraction provider's TPM rate limit.
# INGEST_CONCURRENCY=5
# Durable OpenRouter shadow worker tuning.
# EXTRACTION_JOBS_BATCH_LIMIT=20
# EXTRACTION_JOBS_CONCURRENCY=3

# Admin
ADMIN_EMAIL=your-admin@email.com

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
